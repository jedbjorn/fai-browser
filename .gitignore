node_modules/
artifacts/
.env
.env.*
!.env.example
*.log
*.png
!/bench/report/out/**/*.png
!/extension/icons/*.png
profiles/

# Local disposable credentials and atomic setup temporary files
.env.local
.env.local.*.tmp

# Credentials, local daemon state and captures (at any depth)
.env*
!.env.example
client-token
daemon.json
daemon.lock
daemon.pid
logs/

# Publish only the reviewed compact benchmark records, never raw runs or warmups.
/bench/results/*/*
!/bench/results/*/summary.json
!/bench/results/*/summary.md
!/bench/results/*/config.json
!/bench/results/*/runs.jsonl
/bench/results/*/runs/
/bench/results/*/warmup/
/bench/real/results/*/
/bench/real/results/

# Git metadata must also be excluded by the offline publication scanner.
.git/


# bench/live: only the summaries are published; runs, traces, receipts, answers and grades stay local.
/bench/live/results/*/*
!/bench/live/results/*/summary.json
!/bench/live/results/*/summary.md

# Site-profile hit/miss counters when FAI_HOME points at a checkout
domain-stats/

# Locally saved live pages for offline tuning (never commit)
shared/

# Real-page token benchmark captures, tokenizer downloads and raw strings (never commit)
/bench/tokens/pages/
/bench/tokens/.cache/

# Local agent state
.mcp.json
.playwright-mcp/
.claude/worktrees/

# Built browser packages (npm run build:firefox)
/dist/

# Reviewed release media (raw recordings stay in artifacts/).
!/docs/media/*.png
!/docs/media/*.gif
!/site/media/*.png
/scripts/demo/__pycache__/

# >>> subfloor managed ignores >>>
# The engine is a materialized, gitignored DEPENDENCY (B7) — fetched from
# upstream, refreshed by `./sc update`, never committed to the fork. Your project
# is everything ELSE in this repo.
/.super-coder/
# Boot artifacts + per-shell skill render — rebuilt at launch from the DB.
/CLAUDE.md
/AGENTS.md
/opencode.json
/.claude/skills/
/.agents/skills/
/.opencode/skills/
# Engine-managed harness config re-emitted each launch (per-harness branch-guard
# hook); kept apart from a fork's own tracked config (claude settings.json /
# codex config.toml).
/.claude/settings.local.json
/.codex/hooks.json
# Shell worktrees — one per shell, linked inside the repo root.
/.sc-worktrees/
# The engine pin + source provenance are tracked. Every generated instance
# artifact is local-only.
/.sc-state/engine.ref.prev
/.sc-state/content.sql
/.sc-state/map_content.sql
/.sc-state/map.config.json
/.sc-state/skills_retired.json
/.sc-state/local/
/roadmap_sc.md
/docs_sc/
/specs_sc/
/skills_sc/
# Map DB — derived cache of the repo (dr_*), rebuilt by `./sc map`.
/.sc-state/map.db
/.sc-state/map.db-wal
/.sc-state/map.db-shm
/.sc-state/db_backups/
# <<< subfloor managed ignores <<<
