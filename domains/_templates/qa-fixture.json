{
  "schema": 1,
  "id": "qa-fixture",
  "version": 2,
  "origins": ["{{ORIGIN}}"],
  "description": "QA corpus (fixtures/qa) served by bench/qa/serve.mjs on a random loopback port. A template: bench/qa/run.mjs replaces {{ORIGIN}} and writes it to a scratch FAI_DOMAINS_DIR.",
  "defaults": { "mode": "read-only" },
  "pageTypes": {
    "docs_home": {
      "label": "docs home",
      "url": "/docs/index.html",
      "checks": [{ "heading": "Driftline documentation" }],
      "expect": ["/docs", "/docs/index", "/docs/index.html"]
    },
    "docs_guides": {
      "label": "guides index",
      "url": "/docs/guides/index.html",
      "checks": [{ "heading": "Guides" }, { "title": "Driftline Docs" }],
      "expect": ["/docs/guides", "/docs/guides/index", "/docs/guides/index.html"]
    },
    "docs_deployment": {
      "label": "deployment guides",
      "url": "/docs/guides/deployment/index.html",
      "checks": [{ "heading": "Deployment" }],
      "expect": ["/docs/guides/deployment", "/docs/guides/deployment/index", "/docs/guides/deployment/index.html"]
    },
    "docs_rollbacks": {
      "label": "rollbacks guide",
      "url": "/docs/guides/deployment/rollbacks.html",
      "checks": [{ "heading": "Rollbacks" }],
      "expect": ["/docs/guides/deployment/rollbacks", "/docs/guides/deployment/rollbacks.html"]
    },
    "docs_canary": {
      "label": "canary releases guide",
      "url": "/docs/guides/deployment/canary.html",
      "checks": [{ "heading": "Canary releases" }],
      "expect": ["/docs/guides/deployment/canary", "/docs/guides/deployment/canary.html"]
    },
    "docs_reference": {
      "label": "reference index",
      "url": "/docs/reference/index.html",
      "checks": [{ "heading": "Reference" }],
      "expect": ["/docs/reference", "/docs/reference/index", "/docs/reference/index.html"]
    },
    "docs_cli": {
      "label": "CLI reference",
      "url": "/docs/reference/cli.html",
      "checks": [{ "heading": "CLI reference" }],
      "expect": ["/docs/reference/cli", "/docs/reference/cli.html"]
    },
    "tools_p1": {
      "label": "tool library page 1",
      "url": "/pagination/path/page/1",
      "checks": [{ "heading": "Tool library" }, { "title": "page 1 " }]
    },
    "tools_p2": {
      "label": "tool library page 2",
      "url": "/pagination/path/page/2",
      "checks": [{ "heading": "Tool library" }, { "title": "page 2 " }],
      "expect": ["/page/2", "/pagination/path/page/2"]
    },
    "tools_p3": {
      "label": "tool library page 3",
      "url": "/pagination/path/page/3",
      "checks": [{ "heading": "Tool library" }, { "title": "page 3 " }],
      "expect": ["/page/3", "/pagination/path/page/3"]
    },
    "catalogue_first": {
      "label": "seed catalogue",
      "url": "/pagination/query.html",
      "checks": [{ "heading": "Seed catalogue: page " }]
    },
    "catalogue_page": {
      "label": "seed catalogue page",
      "url": "/pagination/query.html?page={page}",
      "checks": [{ "heading": "Seed catalogue: page " }],
      "expect": ["page={page}", "?page={page}", "/pagination/query.html?page={page}"]
    },
    "dashboard": {
      "label": "dashboard",
      "url": "/errors/dashboard.html",
      "checks": [{ "heading": "Dashboard" }]
    },
    "team": {
      "label": "team page",
      "url": "/errors/team.html",
      "checks": [{ "heading": "Team" }],
      "expect": ["/errors/team", "/errors/team.html"]
    },
    "reports": {
      "label": "reports",
      "url": "/redirect/index.html",
      "checks": [{ "heading": "Reports" }]
    },
    "report": {
      "label": "latest report",
      "url": "/redirect/final.html",
      "checks": [{ "title": "Report R-" }],
      "expect": ["/redirect/final", "/redirect/final.html"]
    },
    "parcel_tools": {
      "label": "parcel tools",
      "url": "/newtab/index.html",
      "checks": [{ "heading": "Parcel tools" }]
    },
    "calculator": {
      "label": "shipping calculator",
      "url": "/newtab/calculator.html",
      "checks": [{ "heading": "Shipping calculator" }],
      "expect": ["/newtab/calculator", "/newtab/calculator.html"]
    },
    "search_results": {
      "label": "search results",
      "url": "/search/results.html",
      "checks": [{ "title": "Searchly" }, { "link": "Lanterns of the Northern Coast" }]
    },
    "search_result": {
      "label": "search result",
      "url": "/search/r/{n}.html",
      "checks": [{ "link": "Back to results" }],
      "expect": ["/search/r/{n}", "/search/r/{n}.html"]
    },
    "glossary": {
      "label": "glossary",
      "url": "/links/glossary.html",
      "checks": [{ "heading": "Glossary" }]
    },
    "glossary_term": {
      "label": "glossary term",
      "url": "/links/term/{slug}",
      "checks": [{ "title": " · Coastal Watch" }],
      "expect": ["/links/term/{slug}"]
    },
    "forum_post": {
      "label": "forum post",
      "url": "/login/forum.html",
      "checks": [{ "heading": "Spring survey results" }]
    },
    "station_map": {
      "label": "station map",
      "url": "/login/station-map.html",
      "checks": [{ "heading": "Station map" }],
      "expect": ["/login/station-map", "/login/station-map.html"]
    },
    "recipe": {
      "label": "cookie recipe",
      "url": "/cookie/recipe.html",
      "checks": [{ "heading": "The Best Brown Butter Cookie" }]
    },
    "cookie_policy": {
      "label": "cookie policy",
      "url": "/cookie/policy.html",
      "checks": [{ "heading": "Cookie policy" }],
      "expect": ["/cookie/policy", "/cookie/policy.html"]
    },
    "cli_overview": {
      "label": "CLI overview",
      "url": "/shadow/nav.html",
      "checks": [{ "heading": "Driftline CLI" }]
    },
    "cli_releases": {
      "label": "CLI releases",
      "url": "/shadow/releases.html",
      "checks": [{ "heading": "Releases" }],
      "expect": ["/shadow/releases", "/shadow/releases.html"]
    },
    "bakery": {
      "label": "bakery start page",
      "url": "/i18n/baeckerei.html",
      "checks": [{ "heading": "Bäckerei Sonnenhof" }]
    },
    "bakery_contact": {
      "label": "bakery contact page",
      "url": "/i18n/kontakt.html",
      "checks": [{ "heading": "Kontakt" }],
      "expect": ["/i18n/kontakt", "/i18n/kontakt.html"]
    },
    "ferry_home": {
      "label": "ferry home",
      "url": "/consent/onetrust.html",
      "checks": [{ "heading": "Harbor Line Ferries" }]
    },
    "ferry_timetable": {
      "label": "ferry timetable",
      "url": "/consent/timetable.html",
      "checks": [{ "heading": "Timetable" }],
      "expect": ["/consent/timetable", "/consent/timetable.html"]
    }
  },
  "edges": [
    { "id": "docs->guides", "from": "docs_home", "to": "docs_guides",
      "link": { "label": "Guides", "href": "/docs/guides/index.html", "hint": "Guides" } },
    { "id": "guides->deployment", "from": "docs_guides", "to": "docs_deployment",
      "link": { "label": "Deployment", "href": "/docs/guides/deployment/index.html", "hint": "Deployment" } },
    { "id": "deployment->rollbacks", "from": "docs_deployment", "to": "docs_rollbacks",
      "link": { "label": "Rollbacks", "href": "/docs/guides/deployment/rollbacks.html", "hint": "Rollbacks" } },
    { "id": "deployment->canary", "from": "docs_deployment", "to": "docs_canary",
      "link": { "label": "Canary releases", "href": "/docs/guides/deployment/canary.html", "hint": "Canary releases" } },
    { "id": "docs->reference", "from": "docs_home", "to": "docs_reference",
      "link": { "label": "Reference", "href": "/docs/reference/index.html", "hint": "Reference" } },
    { "id": "reference->cli", "from": "docs_reference", "to": "docs_cli",
      "link": { "label": "CLI", "href": "/docs/reference/cli.html", "hint": "CLI" } },
    { "id": "tools->p2", "from": "tools_p1", "to": "tools_p2",
      "link": { "label": "Next page", "href": "/pagination/path/page/2", "hint": "Next page" } },
    { "id": "tools->p3", "from": "tools_p2", "to": "tools_p3",
      "link": { "label": "Next page", "href": "/pagination/path/page/3", "hint": "Next page" } },
    { "id": "catalogue->page", "from": "catalogue_first", "to": "catalogue_page",
      "link": { "href": "/pagination/query.html?page={page}" } },
    { "id": "dashboard->team", "from": "dashboard", "to": "team",
      "link": { "label": "Team", "href": "/errors/team.html", "hint": "Team" } },
    { "id": "reports->latest", "from": "reports", "to": "report",
      "link": { "label": "Latest report", "href": "/redirect/start", "hint": "Latest report" } },
    { "id": "tools->calculator", "from": "parcel_tools", "to": "calculator",
      "link": { "label": "Open shipping calculator", "href": "/newtab/calculator.html", "hint": "Open shipping calculator" } },
    { "id": "results->result", "from": "search_results", "to": "search_result",
      "link": { "href": "/search/r/{n}.html" } },
    { "id": "glossary->term", "from": "glossary", "to": "glossary_term",
      "link": { "href": "/links/term/{slug}" } },
    { "id": "forum->map", "from": "forum_post", "to": "station_map",
      "link": { "label": "Station map", "href": "/login/station-map.html", "hint": "Station map" } },
    { "id": "recipe->policy", "from": "recipe", "to": "cookie_policy",
      "link": { "label": "Cookie policy", "href": "/cookie/policy.html", "hint": "Cookie policy" } },
    { "id": "overview->releases", "from": "cli_overview", "to": "cli_releases",
      "link": { "label": "Releases", "href": "/shadow/releases.html", "hint": "Releases" } },
    { "id": "bakery->contact", "from": "bakery", "to": "bakery_contact",
      "link": { "label": "Kontakt", "href": "/i18n/kontakt.html", "hint": "Kontakt" } },
    { "id": "ferry->timetable", "from": "ferry_home", "to": "ferry_timetable",
      "link": { "label": "Timetable", "href": "/consent/timetable.html", "hint": "Timetable" } }
  ]
}
