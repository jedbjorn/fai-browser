{
  "schema": 1,
  "id": "developer.mozilla.org",
  "version": 3,
  "origins": ["https://developer.mozilla.org"],
  "description": "Curated, experimental: the JavaScript section (guide home, reference, standard built-in objects, Array and its method pages). Every locale.",
  "defaults": { "mode": "read-only", "maxActions": 4 },
  "pageTypes": {
    "js_home": {
      "label": "JavaScript home",
      "url": "/{locale}/docs/Web/JavaScript",
      "checks": [{ "title": "JavaScript | MDN" }],
      "expect": ["/docs/Web/JavaScript", "/{locale}/docs/Web/JavaScript"]
    },
    "js_reference": {
      "label": "JavaScript reference",
      "url": "/{locale}/docs/Web/JavaScript/Reference",
      "checks": [{ "title": "- JavaScript | MDN" }],
      "expect": ["/Reference", "/docs/Web/JavaScript/Reference", "/{locale}/docs/Web/JavaScript/Reference"]
    },
    "global_objects": {
      "label": "standard built-in objects",
      "url": "/{locale}/docs/Web/JavaScript/Reference/Global_Objects",
      "checks": [{ "title": "- JavaScript | MDN" }],
      "expect": ["/Global_Objects", "/Reference/Global_Objects", "/{locale}/docs/Web/JavaScript/Reference/Global_Objects"]
    },
    "array": {
      "label": "Array reference",
      "url": "/{locale}/docs/Web/JavaScript/Reference/Global_Objects/Array",
      "checks": [{ "title": "Array - JavaScript | MDN" }],
      "expect": ["Array", "/Array", "/Global_Objects/Array", "/docs/Web/JavaScript/Reference/Global_Objects/Array",
        "/{locale}/docs/Web/JavaScript/Reference/Global_Objects/Array"]
    },
    "array_member": {
      "label": "Array method page",
      "url": "/{locale}/docs/Web/JavaScript/Reference/Global_Objects/Array/{member}",
      "checks": [{ "title": "- JavaScript | MDN" }, { "title": "Array" }],
      "expect": ["Array/{member}", "/Array/{member}", "/Global_Objects/Array/{member}",
        "/docs/Web/JavaScript/Reference/Global_Objects/Array/{member}",
        "/{locale}/docs/Web/JavaScript/Reference/Global_Objects/Array/{member}"]
    }
  },
  "edges": [
    { "id": "home->array", "from": "js_home", "to": "array",
      "link": { "label": "Array", "href": "/{locale}/docs/Web/JavaScript/Reference/Global_Objects/Array", "hint": "Array" } },
    { "id": "home->reference", "from": "js_home", "to": "js_reference",
      "link": { "href": "/{locale}/docs/Web/JavaScript/Reference", "hint": "JavaScript reference" } },
    { "id": "reference->globals", "from": "js_reference", "to": "global_objects",
      "link": { "href": "/{locale}/docs/Web/JavaScript/Reference/Global_Objects", "hint": "Built-in objects" } },
    { "id": "reference->array", "from": "js_reference", "to": "array",
      "link": { "label": "Array", "href": "/{locale}/docs/Web/JavaScript/Reference/Global_Objects/Array", "hint": "Array" } },
    { "id": "globals->array", "from": "global_objects", "to": "array",
      "link": { "label": "Array", "href": "/{locale}/docs/Web/JavaScript/Reference/Global_Objects/Array", "hint": "Array" } },
    { "id": "array->member", "from": "array", "to": "array_member",
      "link": { "href": "/{locale}/docs/Web/JavaScript/Reference/Global_Objects/Array/{member}" } }
  ]
}
