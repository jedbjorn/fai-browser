{
  "schema": 1,
  "id": "booking.com",
  "version": 1,
  "origins": ["https://www.booking.com"],
  "description": "Curated, experimental: Booking.com stay results (/searchresults.html) and hotel pages. A results URL built from the step's destination, dates and guests instead of the pickers, another stay by rewriting checkin and checkout, pinned sort and paging controls. Reserving is refused.",
  "restrict": { "forbid": ["Reserve", "I'll reserve", "Book now", "Sign in", "Register"] },
  "defaults": { "mode": "interactive", "maxActions": 4 },
  "pageTypes": {
    "home": {
      "label": "stay search",
      "url": "/?*",
      "checks": [{ "title": "booking.com" }],
      "expect": ["/"]
    },
    "results": {
      "label": "stay results",
      "url": "/searchresults.html?*",
      "checks": [{ "title": "booking.com" }],
      "expect": ["/searchresults.html", "searchresults.html", "/searchresults"]
    },
    "hotel": {
      "label": "hotel page",
      "url": "/hotel/{country}/{slug}?*",
      "checks": [{ "text": "Check-in" }],
      "expect": ["/hotel/{country}/{slug}", "/hotel/{country}", "/hotel/"]
    }
  },
  "shortcuts": [
    { "id": "results-search", "on": "results", "to": "results", "kind": "booking_search" },
    { "id": "results-dates", "on": "results", "to": "results", "kind": "booking_dates" }
  ],
  "edges": [
    { "id": "results->hotel", "from": "results", "to": "hotel",
      "link": { "href": "/hotel/{country}/{slug}" } }
  ],
  "controls": [
    { "label": "Sort by", "pin": true },
    { "label": "Price (lowest first)", "pin": true },
    { "label": "Load more results", "pin": true },
    { "label": "Next page", "pin": true },
    { "label": "Show on map", "pin": true }
  ],
  "notes": [
    "The check-in and check-out boxes open a calendar to pick a date; typing into them does nothing.",
    "Each stay (check-in, check-out, guests) has its own results page with a distinct URL, so another stay is a different page from this one.",
    "A property marked sold out has no price; a sponsored row is an advertisement placed first."
  ]
}
