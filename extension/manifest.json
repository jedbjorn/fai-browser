{
  "manifest_version": 3,
  "name": "FAI Browser",
  "version": "0.6.2",
  "description": "Lets your coding agent work in one browser tab you approve, on your own machine.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "alarms",
    "tabGroups",
    "nativeMessaging",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:4318/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FAI Browser",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open FAI Browser controls"
    }
  },
  "minimum_chrome_version": "116"
}
